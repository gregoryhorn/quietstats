{
  "name": "quietstats",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private aggregate route counts with local encrypted persistence",
  "author": "Gregory Horn",
  "license": "MIT",
  "scripts": {
    "setup:local": "node scripts/setup.mjs",
    "start": "node server/start.mjs",
    "dev": "npm run start",
    "build": "vite build",
    "test": "node --test --experimental-test-isolation=none tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "package:source": "node scripts/package.mjs",
    "check": "npm test && npm run test:vitest && npm run build && npm run test:browser && npm run package:source",
    "test:vitest": "vitest run",
    "test:runtime": "node tests/runtime.mjs",
    "build:hosted": "QUIETSTATS_PUBLIC_BASE=/quietstats/ vite build"
  },
  "files": [
    "core/",
    "adapters/",
    "server/",
    "client/",
    "public/",
    "vendor/",
    "scripts/setup.mjs",
    "scripts/package.mjs",
    "tests/",
    "index.html",
    "vite.config.js",
    "vitest.config.js",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "DEPENDENCIES.json",
    "package-lock.json",
    "wrangler.example.jsonc"
  ],
  "dependencies": {
    "otpauth": "file:vendor/otpauth",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^7.3.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "prettier": "^3.9.10",
    "vitest": "^4.1.12"
  }
}
